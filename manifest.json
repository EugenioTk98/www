{
  "id": "./index.html",
  "name": "Pokédex 1025 GO • Legacy & MT Elite",
  "short_name": "Pokédex 1025",
  "description": "Checklist completo dos 1.025 Pokémon no Pokémon GO com todos os golpes Legacy (MT Elite, Dia da Comunidade e Legado Antigo), gerador de strings e exportação ODF (.ods).",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "scope_extensions": [
    {
      "origin": "https://*.github.io"
    },
    {
      "origin": "https://*.vercel.app"
    },
    {
      "origin": "https://*.netlify.app"
    }
  ],
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "tab_strip": {
    "home_tab": {
      "url": "./index.html",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    "new_tab_button": {
      "url": "./index.html?tab=strings"
    }
  },
  "orientation": "portrait",
  "background_color": "#0b1120",
  "theme_color": "#0f172a",
  "categories": [
    "games",
    "utilities",
    "entertainment"
  ],
  "iarc_rating_id": "e84b072d-71b3-4def-86ae-0040262df285",
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 420
  },
  "note_taking": {
    "new_note_url": "./index.html?action=new-note"
  },
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+pokedex",
      "url": "./index.html?q=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/json": [
          ".json"
        ]
      },
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "widgets": [
    {
      "name": "Progresso Pokédex 1025 GO",
      "short_name": "Pokédex GO",
      "description": "Acompanhe suas capturas, Shinies, IV 100% e golpes Legacy direto na tela inicial.",
      "tag": "pokedex-1025-progress",
      "template": "pokedex-widget",
      "ms_ac_template": "./widget.json",
      "data": "./widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "./screenshot-mobile.png",
          "sizes": "540x960",
          "label": "Widget de progresso da Pokédex 1025"
        }
      ],
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
